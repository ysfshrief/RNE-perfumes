# ── Database: Neon Postgres ───────────────────────────────────────────
# Vercel → Storage → Neon (or neon.tech) gives you this URL. SERVER-ONLY:
# never prefix it with NEXT_PUBLIC_.
DATABASE_URL=

# Tells the browser to use the database through the site's /api routes.
# Leave empty to run in local demo mode (data stays in the browser).
# NEXT_PUBLIC_BACKEND is set automatically when DATABASE_URL exists at build time.

# Secret used to sign login cookies. Any long random string, e.g. the output
# of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Admin code for the footer gate (tap the RNE logo 3×). Server-checked.
ADMIN_CODE=000

# Only for local demo mode (no database): admin code checked in the browser.
NEXT_PUBLIC_ADMIN_DEMO_CODE=
